local function grabEgg()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if settings.FlyEnabled then
        disableFly()
        task.wait(0.1)
    end
    
    local originalPos = hrp.CFrame
    local playerPos = hrp.Position
    
    local bestTarget = nil
    local highestValue = -math.huge
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = string.lower(obj.Name)
            
            if string.find(name, "egg") or string.find(name, "chest") then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                
                if part then
                    local dist = (part.Position - playerPos).Magnitude
                    
                    if part.Position.Y < (playerPos.Y + 15) and dist < 1000 then
                        local value = 0
                        local weight = obj:FindFirstChild("Weight")
                        local price = obj:FindFirstChild("Price")
                        local rarity = obj:FindFirstChild("Rarity")
                        
                        if weight and weight:IsA("NumberValue") then value = value + weight.Value end
                        if price and price:IsA("NumberValue") then value = value + price.Value end
                        if rarity and rarity:IsA("StringValue") then
                            local r = string.lower(rarity.Value)
                            if r == "secret" then value = value + 100000
                            elseif r == "eternal" then value = value + 80000
                            elseif r == "divine" then value = value + 60000
                            elseif r == "mythic" then value = value + 40000
                            elseif r == "legendary" then value = value + 20000 end
                        end
                        
                        if value == 0 then
                            if string.find(name, "secret") then value = 100000
                            elseif string.find(name, "eternal") then value = 80000
                            elseif string.find(name, "divine") then value = 60000
                            elseif string.find(name, "mythic") then value = 40000
                            elseif string.find(name, "legendary") then value = 20000
                            else value = 1 end
                        end
                        
                        local score = value - dist
                        if score > highestValue then
                            highestValue = score
                            bestTarget = part
                        end
                    end
                end
            end
        end
    end
    
    if bestTarget then
        tpBtn.Text = "Đang cướp..."
        
        hrp.Anchored = true
        hrp.CFrame = CFrame.new(bestTarget.Position)
        task.wait(0.15)
        
        pcall(function()
            if firetouchinterest then
                firetouchinterest(hrp, bestTarget, 0)
                task.wait(0.1)
                firetouchinterest(hrp, bestTarget, 1)
            end
        end)
        
        task.wait(0.15)
        tpBtn.Text = "Đang bay về..."
        
        hrp.CFrame = originalPos
        task.wait(0.15)
        hrp.Anchored = false
        
        tpBtn.Text = "Đã cướp xong!"
        task.wait(1.5)
        tpBtn.Text = "Cướp trứng xịn nhất"
    else
        tpBtn.Text = "Không tìm thấy trứng!"
        task.wait(1.5)
        tpBtn.Text = "Cướp trứng xịn nhất"
    end
end

